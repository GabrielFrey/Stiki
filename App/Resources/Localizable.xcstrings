        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельных объектов нет. Можно оставить всё изображение или нарисовать маску самим."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו אובייקטים נפרדים. אפשר להשאיר את כל התמונה או לצבוע את המסכה ידנית."

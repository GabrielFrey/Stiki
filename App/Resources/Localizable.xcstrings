    "Pick a photo. Stiki lifts the subject on your device and keeps the original so you can edit it later, even inside a pack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a photo. Stiki lifts the subject on your device and keeps the original so you can edit it later, even inside a pack."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото. Stiki вырежет объект на устройстве и сохранит оригинал, чтобы стикер можно было править позже — даже внутри пака."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תמונה. Stiki חותך את האובייקט במכשיר ושומר את המקור כדי שתוכלו לערוך את המדבקה אחר כך, גם בתוך חבילה."
          }
        }
      }
    },

    "Tap a glowing subject to keep it. Drag to refine the mask with the brush.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a glowing subject to keep it. Drag to refine the mask with the brush."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на светящийся объект, чтобы оставить его. Проведите пальцем, чтобы поправить маску кистью."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על אובייקט זוהר כדי להשאיר אותו. גררו כדי לדייק את המסכה במברשת."
          }
        }
      }
    },
    "Subjects": {
      "localizations": {
        "en": {
          "stringUnit": {
